NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=mysql://anajao_app:CHANGE_ME@127.0.0.1:3306/anajao_ecommerce_dev
# Use a separate schema-scoped migration account for DDL.
MIGRATION_DATABASE_URL=mysql://anajao_migrator:CHANGE_ME@127.0.0.1:3306/anajao_ecommerce_dev
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=3000
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
# Required only for integration tests. Database name must end in _test.
TEST_DATABASE_URL=mysql://anajao_test:CHANGE_ME@127.0.0.1:3306/anajao_ecommerce_test
# Generate distinct values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required by server startup. Do not reuse keys or commit real values.
AUTH_SIGNING_KEY=GENERATE_64_HEX_CHARACTERS
MFA_ENCRYPTION_KEY=GENERATE_DIFFERENT_64_HEX_CHARACTERS
AUTH_ISSUER=anajao
AUTH_AUDIENCE=anajao-api
AUTH_RATE_LIMIT_MAX=10
# Optional separate test DDL identity; must point to the same isolated test schema.
# TEST_MIGRATION_DATABASE_URL=
# Explicit admin bootstrap target; must already be verified and MFA enrolled.
# ADMIN_BOOTSTRAP_EMAIL=
