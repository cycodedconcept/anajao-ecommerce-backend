{
  "name": "anajao-ecommerce-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test:smoke": "node scripts/smoke.mjs",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "admin:bootstrap": "node dist/scripts/bootstrap-admin.js",
    "docs:postman": "tsx scripts/generate-postman.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "node": "^24.21.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "mysql2": "3.24.6",
    "deepmerge-ts": "8.0.2"
  }
}
